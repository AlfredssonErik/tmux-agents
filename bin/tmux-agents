#!/usr/bin/env bash
set -u

plugin_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

usage() {
    printf 'usage: %s {install|uninstall|status|doctor}\n' "${0##*/}" >&2
    exit 2
}

[ "$#" -eq 1 ] || usage

case "$1" in
    install|uninstall|status|doctor)
        exec "$plugin_dir/scripts/install-opencode.sh" "$1"
        ;;
    *)
        usage
        ;;
esac
